<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Floating status bubble, shown over other apps while gesture control is running. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Lets the app ask the OEM battery manager not to kill its background service — needed
         on aggressive skins like ColorOS/Realme UI and MIUI. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Briefly wakes the display for the "open palm" gesture. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="true" />

    <!-- Lets the app list launchable apps for the "launch app" gesture action, without the
         broader QUERY_ALL_PACKAGES permission. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.HandsFree"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".GestureGuideActivity"
            android:exported="false" />

        <activity
            android:name=".GestureMappingComposeActivity"
            android:exported="false" />

        <activity
            android:name=".ui.paper.PaperShowcaseActivity"
            android:exported="false" />

        <activity
            android:name=".SensorListActivity"
            android:exported="false" />

        <service
            android:name=".gesture.GestureControlService"
            android:foregroundServiceType="camera"
            android:exported="false" />

        <service
            android:name=".overlay.OverlayBubbleService"
            android:exported="false" />

        <!-- Quick Settings tile, so gestures can be switched on from the notification shade
             without opening the app. Must be exported and hold BIND_QUICK_SETTINGS_TILE: System
             UI binds it, and that permission is what stops anything else from doing so. -->
        <service
            android:name=".gesture.GestureTileService"
            android:label="@string/tile_label"
            android:icon="@drawable/ic_tile_air_sensor"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <!-- Deliberately NOT declaring TOGGLEABLE_TILE: that would let the tile be switched
                 on from the lock screen without unlocking, and this one starts a service that
                 drives the accessibility APIs. Requiring an unlock first costs one swipe. -->
        </service>

        <!-- Force-lock device admin, used only by the "screen off" gesture (see
             AirSensorDeviceAdminReceiver). Inert until the user activates it in Settings. -->
        <receiver
            android:name=".gesture.AirSensorDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".gesture.GestureAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
