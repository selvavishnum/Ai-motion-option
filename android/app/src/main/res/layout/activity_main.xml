<?xml version="1.0" encoding="utf-8"?>
<!--
  One column, one card per decision, generous white space. Every section is the same
  Widget.AirSensor.Card style so the page has one rhythm rather than a stack of ad-hoc spacings,
  and the only colour on the screen is the accent on buttons — on a white page, colour is what
  says "this is the thing to tap".

  The mapping tables that used to live inline here now have their own screen (GestureMappingActivity);
  three RecyclerViews nested in a ScrollView both scrolled badly and buried the settings above them.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/onSurface"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/app_tagline"
            android:textAppearance="@style/TextAppearance.AirSensor.Hint" />

        <!-- Setup ................................................................ -->
        <LinearLayout
            style="@style/Widget.AirSensor.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Setup"
                android:textAppearance="@style/TextAppearance.AirSensor.SectionTitle" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.AirSensor.Hint" />

            <Button
                android:id="@+id/grantCameraButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Allow camera" />

            <Button
                android:id="@+id/openAccessibilityButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Turn on Accessibility permission" />

            <Button
                android:id="@+id/openOverlayButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Allow display over other apps" />

            <Button
                android:id="@+id/openBatteryButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Stop the system killing Air Sensor" />

            <TextView
                android:id="@+id/batteryHintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/battery_hint"
                android:textAppearance="@style/TextAppearance.AirSensor.Hint" />

            <Button
                android:id="@+id/restrictedSettingsButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="&quot;App was denied access&quot;?" />
        </LinearLayout>

        <!-- Gesture control on/off ............................................... -->
        <LinearLayout
            style="@style/Widget.AirSensor.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/serviceSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gesture control"
                android:textAppearance="@style/TextAppearance.AirSensor.SectionTitle" />

            <Button
                android:id="@+id/addTileButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Add Quick Settings tile" />

            <TextView
                android:id="@+id/tileHintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/tile_hint"
                android:textAppearance="@style/TextAppearance.AirSensor.Hint" />
        </LinearLayout>

        <!-- What gets detected .................................................. -->
        <LinearLayout
            style="@style/Widget.AirSensor.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="What to detect"
                android:textAppearance="@style/TextAppearance.AirSensor.SectionTitle" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/handGestureSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Hand gestures" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/faceGestureSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Face gestures" />

            <TextView
                android:id="@+id/speedHintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.AirSensor.Hint" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/waveGestureSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Wave gestures (proximity sensor)" />

            <TextView
                android:id="@+id/waveHintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.AirSensor.Hint" />
        </LinearLayout>

        <!-- Sensitivity ......................................................... -->
        <LinearLayout
            style="@style/Widget.AirSensor.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gesture sensitivity"
                android:textAppearance="@style/TextAppearance.AirSensor.SectionTitle" />

            <TextView
                android:id="@+id/sensitivityValueText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.AirSensor.Hint" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sensitivitySlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:contentDescription="Gesture sensitivity, 1 least to 5 most"
                android:stepSize="1"
                android:valueFrom="1"
                android:valueTo="5"
                app:tickVisible="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sensitivity_hint"
                android:textAppearance="@style/TextAppearance.AirSensor.Hint" />
        </LinearLayout>

        <!-- On-screen extras .................................................... -->
        <LinearLayout
            style="@style/Widget.AirSensor.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="On screen"
                android:textAppearance="@style/TextAppearance.AirSensor.SectionTitle" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/bubbleSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Floating air bubble" />

            <TextView
                android:id="@+id/bubbleHintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/bubble_hint"
                android:textAppearance="@style/TextAppearance.AirSensor.Hint" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/pointerSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Blue finger pointer" />

            <TextView
                android:id="@+id/pointerHintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/pointer_hint"
                android:textAppearance="@style/TextAppearance.AirSensor.Hint" />
        </LinearLayout>

        <!-- Battery ............................................................. -->
        <LinearLayout
            style="@style/Widget.AirSensor.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/batterySaverSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pause while the screen is off"
                android:textAppearance="@style/TextAppearance.AirSensor.SectionTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/screen_off_hint"
                android:textAppearance="@style/TextAppearance.AirSensor.Hint" />
        </LinearLayout>

        <!-- Customise ........................................................... -->
        <LinearLayout
            style="@style/Widget.AirSensor.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gestures"
                android:textAppearance="@style/TextAppearance.AirSensor.SectionTitle" />

            <Button
                android:id="@+id/gestureMappingButton"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Gesture mapping" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/training_hint"
                android:textAppearance="@style/TextAppearance.AirSensor.Hint" />

            <Button
                android:id="@+id/gestureGuideButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Gesture guide" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
