<?xml version="1.0" encoding="utf-8"?>
<!-- A white card on a white page: the hairline stroke is the only thing separating the two, so
     it carries all the structure. An elevation shadow would do the same job less cleanly here —
     shadows read as heavy against this much white. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface" />
    <corners android:radius="14dp" />
    <stroke android:width="1dp" android:color="@color/outline" />
</shape>
