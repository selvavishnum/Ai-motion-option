<?xml version="1.0" encoding="utf-8"?>
<!-- The air pointer. A white ring around the blue core so the dot stays visible over a dark
     photo, a white page or a blue app bar alike — a plain blue dot disappears against blue. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#66000000" />
        </shape>
    </item>
    <item
        android:top="3dp"
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item
        android:top="6dp"
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp">
        <shape android:shape="oval">
            <solid android:color="#3D6BFF" />
        </shape>
    </item>
</layer-list>
